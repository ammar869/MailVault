# App
NODE_ENV=development
PORT=4000

# Database
MONGODB_URI=mongodb://localhost:27017/mailvault
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=your-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=your-refresh-secret-at-least-32-characters-long
BCRYPT_ROUNDS=12

# S3 (MinIO for local dev)
S3_BUCKET=mailvault-dev
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# LLM (optional for MVP)
LLM_API_KEY=
LLM_BASE_URL=

# Webhook secrets (configure after choosing provider)
WEBHOOK_SECRET_SES=
WEBHOOK_SECRET_MAILGUN=

# Client
CLIENT_ORIGIN=http://localhost:5173